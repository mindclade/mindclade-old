{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/schemas/component/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "mindclade.dev/v1"},
    "kind": {"enum": ["Service", "Worker", "Application", "Model"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity", "tier", "languages", "buildTargets", "testTargets", "artifacts", "protocols", "dataClassifications", "runtime"],
      "properties": {
        "maturity": {"enum": ["experimental", "incubating", "supported", "production", "deprecated", "retired"]},
        "tier": {"type": "integer", "minimum": 1, "maximum": 3},
        "languages": {"type": "array", "minItems": 1, "items": {"enum": ["go", "rust", "python", "typescript", "cuda", "tilelang"]}},
        "buildTargets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^//"}},
        "testTargets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^//"}},
        "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": {"type": {"enum": ["oci", "wheel", "npm", "binary", "model-bundle"]}, "name": {"type": "string"}}}},
        "protocols": {"type": "array", "items": {"type": "string", "pattern": "^mindclade\\.[a-z_]+\\.v[0-9]+$"}},
        "dataClassifications": {"type": "array", "minItems": 1, "items": {"enum": ["public", "internal", "confidential", "confidential-metadata", "restricted-biological", "regulated-human-derived"]}},
        "runtime": {"type": "object", "additionalProperties": false, "required": ["kubernetes", "gpu"], "properties": {"kubernetes": {"type": "boolean"}, "gpu": {"type": "boolean"}}}
      }
    }
  }
}
