load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "dependency_policy_test",
    size = "small",
    srcs = ["dependency_policy_test.py"],
    data = glob(
        ["**/*.py"],
        exclude = ["dependency_policy_test.py"],
        allow_empty = True,
    ),
    tags = ["small"],
)

py_library(
    name = "identifiers",
    srcs = [
        "__init__.py",
        "identifiers/__init__.py",
        "identifiers/ids.py",
        "//libs:__init__.py",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "identifiers_test",
    srcs = ["identifiers/ids_test.py"],
    main = "identifiers/ids_test.py",
    size = "small",
    tags = ["small"],
    deps = [":identifiers"],
)

py_library(
    name = "artifacts",
    srcs = [
        "__init__.py",
        "artifacts/__init__.py",
        "artifacts/refs.py",
        "//libs:__init__.py",
    ],
    data = ["//protocols/schemas/artifact_manifest:schema"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//jsonschema",
    ],
)

py_test(
    name = "artifacts_test",
    srcs = ["artifacts/refs_test.py"],
    main = "artifacts/refs_test.py",
    size = "small",
    tags = ["small"],
    deps = [":artifacts"],
)

py_library(
    name = "config",
    srcs = [
        "__init__.py",
        "config/__init__.py",
        "config/loader.py",
        "//libs:__init__.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//jsonschema",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "config_test",
    srcs = ["config/loader_test.py"],
    main = "config/loader_test.py",
    size = "small",
    tags = ["small"],
    deps = [":config"],
)
